# Copy to .env and fill in. Every value has a default except the Google credentials.

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Where the SQLite DB (and later logs) live. Relative paths resolve from the working directory.
DATA_DIR=data

# --- Google Health API (Phase 2) ---
# OAuth client of type "Web application", redirect URI:
#   http://127.0.0.1:8000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
# Fernet key used to encrypt the stored refresh token. Generate one with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FITBIT_SECRET_KEY=

# --- Sync ---
# Intraday types (heart rate, steps, ...) every N minutes; daily/sleep/workouts hourly.
SYNC_INTERVAL_MIN=15
# How far back the first sync goes. Later: `fitbit sync --since YYYY-MM-DD`.
BACKFILL_DAYS=90
# Testing-mode (unverified) apps are limited to 2.5 requests/s per user.
SYNC_REQUESTS_PER_S=2.0
SCHEDULER_ENABLED=true
# v4beta data types (skin-temperature-sensors). Experimental.
ENABLE_BETA_TYPES=false

# --- Local AI (Ollama) ---
AI_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Optional smaller model used if the main one is missing or too slow.
OLLAMA_FALLBACK_MODEL=
OLLAMA_TIMEOUT_S=300
OLLAMA_NUM_CTX=16384
# Let reasoning models think before answering (slower, sometimes better).
OLLAMA_THINK=false
